# Auth-Service local environment example for the Platform-Infra stack.
# Copy this file to .env, replace PLACEHOLDER_* values, and export the
# variables in your shell or IDE before running the service.

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081

AUTH_DB_URL=jdbc:postgresql://localhost:5432/platform
AUTH_DB_USERNAME=PLACEHOLDER_PLATFORM_POSTGRES_USERNAME
AUTH_DB_PASSWORD=PLACEHOLDER_PLATFORM_POSTGRES_PASSWORD

AUTH_KEYCLOAK_SERVER_URL=http://localhost:8080
AUTH_KEYCLOAK_REALM=az
AUTH_KEYCLOAK_CLIENT_ID=auth-service
AUTH_KEYCLOAK_CLIENT_SECRET=PLACEHOLDER_AUTH_SERVICE_CLIENT_SECRET
AUTH_KEYCLOAK_ADMIN_REALM=master
AUTH_KEYCLOAK_ADMIN_CLIENT_ID=auth-service-admin
AUTH_KEYCLOAK_ADMIN_CLIENT_SECRET=PLACEHOLDER_AUTH_SERVICE_ADMIN_CLIENT_SECRET
AUTH_KEYCLOAK_ADMIN_USERNAME=PLACEHOLDER_KEYCLOAK_ADMIN_USERNAME
AUTH_KEYCLOAK_ADMIN_PASSWORD=PLACEHOLDER_KEYCLOAK_ADMIN_PASSWORD
